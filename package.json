{
  "name": "@orion-agents/orion-code",
  "version": "0.2.0",
  "description": "Orion Code - goal-driven coding agent for the terminal.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "orion": "bin/orion"
  },
  "files": [
    "dist/",
    "bin/",
    "assets/orion-tui-icon.png",
    "CHANGELOG.md",
    "docs/orion.example.json",
    "docs/readme.md",
    "docs/migration/v0.1.9-to-v0.2.0.md",
    "docs/plan/v0.2.0-dsh-harness-redesign-plan.md",
    "docs/plan/v0.2.0-release-checklist.md",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "start": "ts-node src/cli.ts",
    "dev": "nodemon src/cli.ts",
    "cli": "ts-node src/cli.ts",
    "clean": "node scripts/maintenance/clean-dist.js",
    "build": "npm run clean && tsc && node scripts/maintenance/copy-runtime-assets.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "deps:check": "bash scripts/release/dep-health-check.sh",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "release:check": "node scripts/release/release-check.js",
    "bench:harness": "ts-node --transpile-only scripts/bench/harness-runtime.ts",
    "bench:harness:baseline": "ts-node --transpile-only scripts/bench/harness-runtime.ts --mode baseline",
    "bench:harness:baseline:frozen": "ts-node --transpile-only scripts/bench/frozen-v019-baseline.ts",
    "bench:harness:compare": "ts-node --transpile-only scripts/bench/compare-harness.ts",
    "bench:harness:eval": "ts-node --transpile-only scripts/bench/harness-eval.ts",
    "test:harness-confluence": "ts-node --transpile-only scripts/bench/harness-confluence.ts",
    "release:artifact": "ts-node --transpile-only scripts/release/build-release-artifact.ts",
    "release:gate-evidence": "ts-node --transpile-only scripts/release/gate-evidence.ts",
    "release:receipt": "ts-node --transpile-only scripts/release/assemble-release-receipt.ts",
    "test:runtime-matrix": "ts-node --transpile-only scripts/release/runtime-matrix.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run deps:check -- --policy-only && npm run lint && npm run build && npm run test:harness-confluence && npm run release:check -- --skip-tests && npm run test:coverage -- --runInBand"
  },
  "keywords": [
    "agent",
    "ai",
    "coding-agent",
    "cli-agent",
    "llm",
    "openai",
    "claude",
    "mcp",
    "harness",
    "automation",
    "coding-assistant",
    "developer-tools"
  ],
  "author": "Linux2010",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orion-agents/orion-code.git"
  },
  "homepage": "https://github.com/orion-agents/orion-code#readme",
  "bugs": {
    "url": "https://github.com/orion-agents/orion-code/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.10.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "dotenv": "^16.6.1",
    "eventemitter3": "^5.0.1",
    "figlet": "^1.11.0",
    "js-yaml": "^4.3.0",
    "marked": "^11.2.0",
    "marked-terminal": "^6.2.0",
    "openai": "^6.49.0",
    "signal-exit": "^4.1.0",
    "sqlite-vec": "^0.1.9",
    "string-width": "^4.2.3",
    "throttle": "^1.0.3",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/figlet": "^1.5.8",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || ^24.0.0"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "type": "commonjs"
}
