{
  "name": "@orion-agents/orion-code",
  "version": "0.3.9",
  "description": "Orion Code - local-first goal-driven coding agent for terminal and Web.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "orion": "bin/orion"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "bin/",
    "assets/orion-tui-icon.png",
    "CHANGELOG.md",
    "docs/orion.example.json",
    "docs/readme.md",
    "docs/migration/v0.1.9-to-v0.2.0.md",
    "docs/migration/v0.2.2-to-v0.3.0.md",
    "docs/migration/v0.2.2-to-v0.3.0-settings.md",
    "docs/migration/v0.3.0-to-v0.3.1.md",
    "docs/migration/v0.3.1-to-v0.3.2.md",
    "docs/migration/v0.3.2-to-v0.3.3.md",
    "docs/migration/v0.3.3-to-v0.3.4.md",
    "docs/plan/v0.2.0-dsh-harness-redesign-plan.md",
    "docs/plan/v0.2.0-release-checklist.md",
    "docs/plan/v0.3.0-web-workbench-plan.md",
    "docs/plan/v0.3.0-settings-integration-plan.md",
    "docs/plan/v0.3.0-node-runtime-compatibility-plan.md",
    "docs/plan/v0.3.1-web-workbench-professional-shell-plan.md",
    "docs/plan/v0.3.2-web-workbench-layout-and-composer-plan.md",
    "docs/plan/v0.3.3-plan.md",
    "docs/plan/v0.3.4-stabilization-plan.md",
    "docs/test/v0.3.1-web-workbench-e2e-plan.md",
    "docs/test/v0.3.2-web-workbench-e2e-plan.md",
    "docs/test/v0.3.3-web-workbench-e2e-plan.md",
    "docs/test/v0.3.4-stabilization-e2e-plan.md",
    "docs/architecture/v0.3.0-web-api.yaml",
    "docs/architecture/v0.3.1-web-api.yaml",
    "docs/architecture/v0.3.2-web-api.yaml",
    "docs/architecture/v0.3.3-web-api.yaml",
    "docs/architecture/v0.3.4-stabilization-contract.md",
    "docs/architecture/agent-mode-permission-contract.md",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "start": "ts-node src/cli.ts",
    "dev": "nodemon src/cli.ts",
    "cli": "ts-node src/cli.ts",
    "clean": "node scripts/maintenance/clean-dist.js",
    "build": "npm run clean && npm run build:server && npm run build:web && node scripts/maintenance/copy-runtime-assets.js",
    "build:server": "tsc",
    "build:web": "tsc -p web/tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test": "jest",
    "test:web-browser": "ts-node --transpile-only scripts/smoke/web-workbench-browser.ts",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json",
    "test:web-e2e": "playwright test",
    "test:web-e2e:critical": "ts-node --transpile-only scripts/e2e/run-web-e2e-critical.ts",
    "test:web-e2e:primary": "ts-node --transpile-only scripts/e2e/run-web-e2e-primary.ts",
    "test:web-e2e:matrix": "ts-node --transpile-only scripts/e2e/run-web-e2e-matrix.ts",
    "test:coverage": "jest --coverage",
    "deps:check": "bash scripts/release/dep-health-check.sh",
    "lint": "eslint src/ web/src/ scripts/smoke/web-workbench-browser.ts scripts/e2e/ tests/e2e/ playwright.config.ts",
    "format": "prettier --write src/ web/src/ scripts/smoke/web-workbench-browser.ts scripts/e2e/ tests/e2e/ playwright.config.ts",
    "format:check": "prettier --check src/ web/src/ scripts/smoke/web-workbench-browser.ts scripts/e2e/ tests/e2e/ playwright.config.ts",
    "release:check": "node scripts/release/release-check.js",
    "bench:harness": "ts-node --transpile-only scripts/bench/harness-runtime.ts",
    "bench:harness:baseline": "ts-node --transpile-only scripts/bench/harness-runtime.ts --mode baseline",
    "bench:harness:baseline:frozen": "ts-node --transpile-only scripts/bench/frozen-v019-baseline.ts",
    "bench:harness:compare": "ts-node --transpile-only scripts/bench/compare-harness.ts",
    "bench:harness:eval": "ts-node --transpile-only scripts/bench/harness-eval.ts",
    "test:harness-confluence": "ts-node --transpile-only scripts/bench/harness-confluence.ts",
    "release:artifact": "ts-node --transpile-only scripts/release/build-release-artifact.ts",
    "release:gate-evidence": "ts-node --transpile-only scripts/release/gate-evidence.ts",
    "release:web-e2e-receipt": "ts-node --transpile-only scripts/e2e/assemble-web-e2e-receipt.ts",
    "release:receipt": "ts-node --transpile-only scripts/release/assemble-release-receipt.ts",
    "test:runtime-matrix": "ts-node --transpile-only scripts/release/runtime-matrix.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run deps:check -- --policy-only && npm run lint && npm run build && npm run test:web-browser && npm run test:harness-confluence && npm run release:check -- --skip-tests && npm run test:coverage -- --runInBand"
  },
  "keywords": [
    "agent",
    "ai",
    "coding-agent",
    "cli-agent",
    "llm",
    "openai",
    "claude",
    "mcp",
    "harness",
    "automation",
    "coding-assistant",
    "developer-tools"
  ],
  "author": "Linux2010",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orion-agents/orion-code.git"
  },
  "homepage": "https://github.com/orion-agents/orion-code#readme",
  "bugs": {
    "url": "https://github.com/orion-agents/orion-code/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.10.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "dotenv": "^17.4.2",
    "eventemitter3": "^5.0.1",
    "figlet": "^1.11.0",
    "js-yaml": "^4.3.0",
    "marked": "^11.2.0",
    "marked-terminal": "^6.2.0",
    "node-pty": "1.2.0-beta.15",
    "openai": "^6.49.0",
    "signal-exit": "^4.1.0",
    "sqlite-vec": "^0.1.9",
    "string-width": "^4.2.3",
    "throttle": "^1.0.3",
    "undici": "^6.28.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/figlet": "^1.5.8",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "5.1.4",
    "axe-core": "4.13.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "playwright-core": "1.62.1",
    "prettier": "^3.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vite": "7.3.6"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "type": "commonjs",
  "allowScripts": {
    "node-pty@1.2.0-beta.15": true
  }
}
