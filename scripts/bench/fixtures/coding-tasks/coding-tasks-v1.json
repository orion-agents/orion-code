    {
      "id": "CT-03",
      "category": "multi-file-refactor",
      "title": "Rename the module across files",
      "instruction": "Rename helper.js to util.js and update both importers to reference util.js.",
      "repo": {
        "files": {
          "src/helper.js": "module.exports = { add };\nfunction add(a, b) { return a + b; }\n",
          "src/main.js": "const { add } = require('./helper');\nconsole.log(add(1, 2));\n",
          "test/helper.test.js": "const { add } = require('../helper');\n"
        }
      },
      "script": [
        {
          "op": "read",
          "path": "src/helper.js"
        },
        {
          "op": "write",
          "path": "src/util.js",
          "content": "module.exports = { add };\nfunction add(a, b) { return a + b; }\n"
        },
        {
          "op": "delete",
          "path": "src/helper.js"
        },
        {
          "op": "write",
          "path": "src/main.js",
          "content": "const { add } = require('./util');\nconsole.log(add(1, 2));\n"
        },
        {
          "op": "write",
          "path": "test/helper.test.js",
          "content": "const { add } = require('../util');\n"
        }
      ],
      "checks": [
        {
          "kind": "file_exists",
          "path": "src/util.js"
        },
        {
          "kind": "file_absent",
          "path": "src/helper.js"
        },
        {
          "kind": "file_contains",
          "path": "src/main.js",
          "value": "require('./util')"
        },
        {
          "kind": "file_contains",
          "path": "test/helper.test.js",
          "value": "require('../util')"
        }
      ],
      "expectedModelRequests": 5,
      "estimatedTokensPerRequest": 540
    },
