{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:orion-code:signature-envelope:v1",
  "title": "Orion Code Update Signature Envelope V1",
  "description": "Detached Ed25519 signature metadata for exact update-index bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "algorithm", "key_id", "signature"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "algorithm": {
      "const": "ed25519"
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "signature": {
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$"
    }
  }
}
